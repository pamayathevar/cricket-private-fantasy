{
  "name": "cricket-private-fantasy-league",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist",
    "export:production": "expo export --platform all --output-dir .expo/production-export",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "score:fetch": "node scripts/fetch-scorecard.mjs",
    "score:compile": "node scripts/compile-score-import.mjs",
    "check:secrets": "node scripts/check-tracked-secrets.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run check:secrets && npm run export:web",
    "check:production": "expo-doctor && npm run check && npm run export:production && npm audit --omit=dev --audit-level=critical"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "2.112.0",
    "expo": "~57.0.14",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.12",
    "expo-splash-screen": "~57.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.10",
    "expo-doctor": "^1.20.1",
    "playwright-core": "^1.62.1",
    "typescript": "~6.0.3"
  }
}
